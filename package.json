{
  "name": "zhixue-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test server/api.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs",
    "test:unit": "vitest run",
    "test:api": "node --test server/api.test.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}