{
  "name": "zhixue-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:engine && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run build:engine && node --test server/api.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server": "npm run build:engine && node server/index.mjs",
    "start": "npm run build:engine && tsc --noEmit && vite build && node server/index.mjs",
    "test:unit": "vitest run",
    "test:api": "npm run build:engine && node --test server/api.test.mjs",
    "test:e2e": "npm run build:engine && node scripts/e2e.mjs",
    "build:engine": "esbuild src/domain/engine.ts --bundle --format=esm --platform=neutral --outfile=server/engine.generated.mjs --log-level=warning",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}