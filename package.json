{
  "name": "zhixue-app",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:engine && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run build:engine && node --test server/api.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server": "npm run build:engine && node server/index.mjs",
    "start": "npm run build:engine && tsc --noEmit && vite build && node server/index.mjs",
    "test:unit": "vitest run",
    "test:api": "npm run build:engine && node --test server/api.test.mjs",
    "test:e2e": "npm run build:engine && node scripts/e2e.mjs",
    "build:engine": "esbuild src/domain/index.ts --bundle --format=esm --platform=neutral --outfile=server/engine.generated.mjs --log-level=warning",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "description": "智学节律 · 把长期目标拆到今天，偏离计划时给出可执行的调整",
  "homepage": "https://github.com/JiangGengrui/zhixue-rhythm"
}